// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ CUSTOMERS ============

model Customer {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?
  cognito_id    String    @unique

  // Personal info (optional for customers to provide)
  first_name    String?
  last_name     String?
  date_of_birth DateTime?

  // Status
  status        String    @default("active") // active, suspended, deleted

  // Relations
  assessments   Assessment[]
  accepted_plans AcceptedPlan[]
  payments      Payment[]
  cases         Case[]
  bank_connections BankConnection[]

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([email])
  @@index([cognito_id])
}

// ============ BANK CONNECTIONS ============

model BankConnection {
  id                      String    @id @default(uuid())
  customer_id             String
  customer                Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  bank_name               String    // e.g., "Barclays", "HSBC"
  account_id              String    // Last 4 digits or masked
  oauth_token             String    @db.Text // Encrypted
  token_expires_at        DateTime?

  last_sync_at            DateTime?
  months_data_available   Int       @default(0)
  data_quality_score      Float     @default(0) // 0-1

  status                  String    @default("connected") // connected, expired, invalid, revoked

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  assessments             Assessment[]

  @@index([customer_id])
  @@index([status])
}

// ============ ASSESSMENTS ============

model Assessment {
  id                      String    @id @default(uuid())
  customer_id             String
  customer                Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  bank_connection_id      String?
  bank_connection         BankConnection? @relation(fields: [bank_connection_id], references: [id])

  // Financial data
  monthly_income          Decimal   @db.Decimal(10, 2)
  total_expenses          Decimal   @db.Decimal(10, 2)
  disposable_income       Decimal   @db.Decimal(10, 2)
  bill_amount             Decimal   @db.Decimal(10, 2)
  bill_percentage         Float     // Bill as % of disposable
  arrears                 Decimal   @db.Decimal(10, 2)

  // Classification
  hardship_level          String    // NONE, LOW, MODERATE, SEVERE
  confidence_score        Float     @db.Decimal(5, 2) // 0-100

  // Flags & Issues
  manual_review_flags     String[]  // e.g., ["previous_default", "high_bill_ratio"]
  data_quality_issues     String[]  // e.g., ["insufficient_data", "outlier_detected"]

  // Vulnerabilities (JSON for flexibility)
  vulnerabilities         Json      @default("{}") // { "pensioner": true, "medical_equipment": false }

  // Breakdown details
  income_breakdown        Json      @default("{}") // { "salary": X, "benefits": Y }
  expense_breakdown       Json      @default("{}") // { "housing": X, "food": Y, "utilities": Z }

  // Relations
  payment_plans           PaymentPlan[]
  cases                   Case[]

  created_at              DateTime  @default(now())
  version                 Int       @default(1) // For audit trail

  @@index([customer_id])
  @@index([hardship_level])
  @@index([created_at])
}

// ============ PAYMENT PLANS ============

model PaymentPlan {
  id                      String    @id @default(uuid())
  assessment_id           String
  assessment              Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  monthly_payment         Decimal   @db.Decimal(10, 2)
  duration_months         Int
  sustainability_score    String    // HIGH, MEDIUM, LOW
  plan_type               String    // CONSERVATIVE, BALANCED, AGGRESSIVE

  is_recommended          Boolean   @default(false)

  total_to_pay            Decimal   @db.Decimal(10, 2) // Usually = arrears

  // If this plan was modified by officer
  modified_from_id        String?
  modification_reason     String?

  // Relations
  accepted_plans          AcceptedPlan[]

  created_at              DateTime  @default(now())

  @@index([assessment_id])
  @@index([plan_type])
}

// ============ ACCEPTED PLANS ============

model AcceptedPlan {
  id                      String    @id @default(uuid())
  customer_id             String
  customer                Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  plan_id                 String
  plan                    PaymentPlan @relation(fields: [plan_id], references: [id])

  accepted_at             DateTime
  acceptance_method       String    // direct_debit, bank_transfer, cash_post_office

  // Payment schedule
  first_payment_date      DateTime
  payment_day_of_month    Int       // 1-28

  // Status
  status                  String    @default("active") // active, completed, breached, cancelled
  completion_rate         Float     @default(0) // 0-100

  // For reassessment
  reassessment_completed  Boolean   @default(false)
  reassessment_at         DateTime?

  // Relations
  payments                Payment[]

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([customer_id])
  @@index([status])
}

// ============ PAYMENTS ============

model Payment {
  id                      String    @id @default(uuid())
  accepted_plan_id        String
  accepted_plan           AcceptedPlan @relation(fields: [accepted_plan_id], references: [id], onDelete: Cascade)

  customer_id             String
  customer                Customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  due_date                DateTime
  amount                  Decimal   @db.Decimal(10, 2)
  status                  String    @default("pending") // pending, paid, overdue, missed, rescheduled

  actual_payment_date     DateTime?
  actual_amount           Decimal?  @db.Decimal(10, 2)

  // For missed payment workflow
  grace_period_ends_at    DateTime?
  check_in_sent_at        DateTime?

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([customer_id])
  @@index([due_date])
  @@index([status])
  @@index([accepted_plan_id])
}

// ============ CASES (Manual Review Queue) ============

model Case {
  id                      String    @id @default(uuid())
  assessment_id           String
  assessment              Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  priority                String    @default("MEDIUM") // HIGH, MEDIUM, LOW
  flag_reason             String    // Why system flagged it

  // Officer workflow
  assigned_to_officer     String?   // Cognito user ID
  status                  String    @default("pending") // pending, in_review, approved, modified, escalated, info_requested, rejected

  decision_at             DateTime?
  decision_notes          String?   @db.Text

  // If officer modified the plan
  modified_plan_id        String?
  override_reason         String?   @db.Text

  // If escalated
  escalated_to_officer    String?
  escalation_reason       String?   @db.Text

  // Relations
  audit_logs              AuditLog[]

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([priority])
  @@index([status])
  @@index([assigned_to_officer])
  @@index([created_at])
}

// ============ AUDIT TRAIL (Immutable) ============

model AuditLog {
  id                      String    @id @default(uuid())
  case_id                 String
  case                    Case      @relation(fields: [case_id], references: [id], onDelete: Cascade)

  entity_type             String    // assessment, case, plan, payment, policy
  entity_id               String

  action                  String    // created, approved, modified, escalated, overridden, rejected
  actor_id                String    // Cognito user ID or "system"
  actor_role              String    // officer, manager, compliance, system

  changes                 Json?     // { before: {}, after: {} }
  reasoning               String?   @db.Text

  ip_address              String?
  user_agent              String?

  created_at              DateTime  @default(now()) @db.Timestamp(3)

  @@index([case_id])
  @@index([entity_type, entity_id])
  @@index([actor_id])
  @@index([created_at])
}

// ============ HARDSHIP POLICY ============

model HardshipPolicy {
  id                                  String    @id @default(uuid())

  // Affordability thresholds
  severe_hardship_threshold           Float     @default(25)
  moderate_hardship_threshold         Float     @default(10)
  low_hardship_threshold              Float     @default(5)

  // Payment plan limits
  max_plan_duration                   Int       @default(36) // months
  min_monthly_payment                 Decimal   @default("10") @db.Decimal(10, 2)
  max_payment_percent_disposable      Float     @default(20)

  // Vulnerability multipliers
  pensioner_duration_multiplier       Float     @default(1.5) // 50% longer
  lone_parent_duration_multiplier     Float     @default(1.3) // 30% longer

  // Manual review triggers
  flag_if_previous_default            Boolean   @default(true)
  flag_if_bill_ratio_exceeds          Float     @default(18)
  flag_if_data_quality_below          Float     @default(0.7)

  effective_date                      DateTime  @default(now())
  created_by                          String    // Cognito user ID
  updated_at                          DateTime  @updatedAt
}

// ============ POLICY CHANGE LOG (Immutable) ============

model PolicyChangeLog {
  id                      String    @id @default(uuid())

  previous_policy         Json      @db.Text
  new_policy              Json      @db.Text

  reason                  String    @db.Text
  changed_by              String    // Cognito user ID

  created_at              DateTime  @default(now()) @db.Timestamp(3)

  @@index([created_at])
}

// ============ COMPLIANCE METRICS (Pre-calculated) ============

model ComplianceMetric {
  id                      String    @id @default(uuid())
  metric_date             DateTime  @default(now())

  // FCA metrics
  total_assessments       Int       @default(0)
  assessments_with_documented_reasoning Int @default(0)
  payment_plans_sustainable Float   @default(0) // percentage

  // Ofgem metrics
  psr_customers_identified Int      @default(0)
  psr_customers_protected Int       @default(0)
  no_disconnection_guarantees Int   @default(0)

  // Discrimination detection
  approval_rate_by_age    Json      @default("{}") // { "18-30": 85, "60+": 82 }
  approval_rate_by_location Json    @default("{}") // { "north": 85, "south": 87 }
  approval_rate_by_income Json      @default("{}") // { "low": 83, "high": 88 }
  fairness_score          Float     @default(0) // 0-100, should be >90

  // ROI & Business
  disconnections_prevented Int      @default(0)
  arrears_recovered       Decimal   @default("0") @db.Decimal(12, 2)
  program_cost            Decimal   @default("0") @db.Decimal(12, 2)
  roi_ratio               Float     @default(0)

  updated_at              DateTime  @updatedAt

  @@index([metric_date])
}
