generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  externalId      String   @unique  // From Cognito (sub)
  firstName       String?
  lastName        String?
  role            String   @default("customer")  // 'customer' | 'admin'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customerId      String?  @unique
  customer        Customer? @relation(fields: [customerId], references: [id])

  refreshTokens   RefreshToken[]
  sessionLogs     SessionLog[]

  @@index([externalId])
  @@index([role])
}

model RefreshToken {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token           String   @unique
  tokenHash       String
  revokedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model SessionLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action          String   // LOGIN, LOGOUT, REFRESH_TOKEN, TOKEN_EXPIRED, ACCOUNT_LINKED
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Customer {
  id              String   @id @default(cuid())
  email           String   @unique
  firstName       String?
  lastName        String?
  phone           String?
  address         String?
  postcode        String?
  utilityAccountNo String?
  utilityType     String?  // 'Electricity', 'Gas', 'Water'
  monthlyBill     Float?
  arrears         Float?

  user            User?

  bankConnections BankConnection[]
  assessments     Assessment[]
  mandates        Mandate[]
  paymentMethods  PaymentMethod[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BankConnection {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  oauthState      String   @unique

  status          String   @default("PENDING")

  bankAccounts    BankAccount[]
  incomeData      BankIncomeReport?
  expenseData     BankExpenseReport?
  riskInsights    BankRiskInsights?
  bankReports     BankReports?
  assessments     Assessment[]

  connectedAt     DateTime?
  dataRetrievedAt DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([oauthState])
}

model BankAccount {
  id               String          @id @default(cuid())
  bankConnectionId String
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  accountId        String
  accountNumber    String
  routingNumber    String?
  accountType      String
  institutionName  String
  currency         String          @default("GBP")

  createdAt        DateTime        @default(now())

  @@index([bankConnectionId])
}

model BankIncomeReport {
  id               String          @id @default(cuid())
  bankConnectionId String          @unique
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  monthlyIncome    Float
  salaryIncome     Float?
  otherIncome      Float?

  dataSource       String
  analysisMonth    DateTime
  createdAt        DateTime        @default(now())
}

model BankExpenseReport {
  id               String          @id @default(cuid())
  bankConnectionId String          @unique
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  monthlyExpenses  Float
  utilities        Float?
  housing          Float?
  food             Float?
  transport        Float?
  other            Float?

  dataSource       String
  analysisMonth    DateTime
  createdAt        DateTime        @default(now())
}

model BankRiskInsights {
  id               String          @id @default(cuid())
  bankConnectionId String          @unique
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  accountBalance   Float
  transactionVolume Float
  overdraftUsage   Boolean

  dataSource       String
  analysisDate     DateTime
  createdAt        DateTime        @default(now())
}

model BankReports {
  id                     String          @id @default(cuid())
  bankConnectionId       String          @unique
  bankConnection         BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  expensesJson           String
  incomeJson             String

  totalMonthlyExpenses   Float
  totalMonthlyIncome     Float

  createdAt              DateTime        @default(now())
  expiresAt              DateTime?

  @@index([bankConnectionId])
}

model Assessment {
  id                String          @id @default(cuid())
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  bankConnectionId  String?
  bankConnection    BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)

  mandateId         String?
  mandate           Mandate?        @relation(fields: [mandateId], references: [id], onDelete: SetNull)

  paymentSchedules  PaymentSchedule[] @relation("AssessmentPaymentSchedule")

  monthlyIncome     Float?
  monthlyExpenses   Float?
  monthlyBill       Float?
  arrears           Float?

  disposableIncome  Float?
  billRatio         Float?
  hardshipLevel     String?
  sustainabilityScore String?

  incomeBreakdown   String?         // JSON: { salary, pension, benefits, cashDeposits, other, total }
  expenseBreakdown  String?         // JSON: { housing, food, utilities, transport, other, total }

  expensesByCategory String?        // JSON: { Housing: 1200, Utilities: 280, Food: 300, Transport: 150, Other: 170 }
  incomeHistory     String?         // JSON: [{ month: "Mar 2026", amount: 1950 }, ...]
  incomeSources     String?         // JSON: [{ type: "Employment", amount: 1950, frequency: "Monthly" }, ...]
  factors           String?         // JSON: [{ title: "Household size 4", description: "..." }, ...]
  paymentPlans      String?         // JSON: [{ type: "Conservative", monthlyAmount: 185, duration: 36, totalRepayment: 6660, sustainability: "HIGH" }, ...]

  selectedPlan      String?         // 'Conservative' | 'Balanced' | 'Aggressive' — set when customer accepts T&C

  status            String          @default("PENDING")

  assessmentJob     AssessmentJob?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerId])
  @@index([bankConnectionId])
}

model AssessmentJob {
  id                String          @id @default(cuid())
  assessmentId      String          @unique
  assessment        Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  status            String          @default("PENDING")
  errorMessage      String?
  retryCount        Int             @default(0)

  createdAt         DateTime        @default(now())
  processedAt       DateTime?

  @@index([status])
}

// ── Payment Processing ──────────────────────────────────────────

model Mandate {
  id                String          @id @default(cuid())
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assessments       Assessment[]
  paymentMethods    PaymentMethod[]
  paymentSchedules  PaymentSchedule[]

  gocardlessId      String          @unique  // GC mandate ID
  status            String          @default("PENDING")  // 'pending' | 'active' | 'failed' | 'cancelled'

  accountHolderName String
  bankAccountNumber String?         // Last 4 digits only
  sortCode          String?         // Masked for display

  createdAt         DateTime        @default(now())
  expiresAt         DateTime?

  @@index([customerId])
  @@index([gocardlessId])
}

model PaymentSchedule {
  id                String          @id @default(cuid())
  mandateId         String
  mandate           Mandate         @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  assessmentId      String
  assessment        Assessment      @relation("AssessmentPaymentSchedule", fields: [assessmentId], references: [id], onDelete: Cascade)

  payments          Payment[]

  gocardlessId      String          @unique  // GC subscription ID
  planType          String          // 'Conservative' | 'Balanced' | 'Aggressive'
  monthlyAmount     Int
  totalAmount       Int
  dayOfMonth        Int             // 1-28 or end of month
  status            String          @default("ACTIVE")  // 'active' | 'completed' | 'cancelled' | 'failed'

  firstPaymentDate  DateTime
  finalPaymentDate  DateTime

  createdAt         DateTime        @default(now())

  @@index([mandateId])
  @@index([assessmentId])
  @@index([gocardlessId])
}

model Payment {
  id                String          @id @default(cuid())
  paymentScheduleId String
  paymentSchedule   PaymentSchedule @relation(fields: [paymentScheduleId], references: [id], onDelete: Cascade)

  gocardlessId      String          @unique  // GC payment ID
  amount            Int
  scheduledDate     DateTime
  actualDate        DateTime?
  status            String          @default("PENDING")  // 'pending' | 'submitted' | 'confirmed' | 'failed'
  failureReason     String?

  createdAt         DateTime        @default(now())

  @@index([paymentScheduleId])
  @@index([gocardlessId])
  @@index([status])
}

model PaymentMethod {
  id                String          @id @default(cuid())
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  mandateId         String
  mandate           Mandate         @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  type              String          @default("direct_debit")  // 'direct_debit'
  isDefault         Boolean         @default(false)

  createdAt         DateTime        @default(now())

  @@index([customerId])
  @@index([mandateId])
}
