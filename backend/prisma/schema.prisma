generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  externalId      String   @unique  // From Cognito (sub)
  firstName       String?
  lastName        String?
  role            String   @default("customer")  // 'customer' | 'admin'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customerId      String?  @unique
  customer        Customer? @relation(fields: [customerId], references: [id])

  refreshTokens   RefreshToken[]
  sessionLogs     SessionLog[]

  @@index([externalId])
  @@index([role])
}

model RefreshToken {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token           String   @unique
  tokenHash       String
  revokedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model SessionLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action          String   // LOGIN, LOGOUT, REFRESH_TOKEN, TOKEN_EXPIRED, ACCOUNT_LINKED
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model Customer {
  id              String   @id @default(cuid())
  email           String   @unique
  firstName       String?
  lastName        String?
  phone           String?
  address         String?
  postcode        String?
  utilityAccountNo String?
  utilityType     String?  // 'Electricity', 'Gas', 'Water'
  monthlyBill     Float?
  arrears         Float?

  user            User?

  bankConnections BankConnection[]
  assessments     Assessment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BankConnection {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  oauthState      String   @unique

  status          String   @default("PENDING")

  bankAccounts    BankAccount[]
  incomeData      BankIncomeReport?
  expenseData     BankExpenseReport?
  riskInsights    BankRiskInsights?
  bankReports     BankReports?
  assessments     Assessment[]

  connectedAt     DateTime?
  dataRetrievedAt DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([oauthState])
}

model BankAccount {
  id               String          @id @default(cuid())
  bankConnectionId String
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  accountId        String
  accountNumber    String
  routingNumber    String?
  accountType      String
  institutionName  String
  currency         String          @default("GBP")

  createdAt        DateTime        @default(now())

  @@index([bankConnectionId])
}

model BankIncomeReport {
  id               String          @id @default(cuid())
  bankConnectionId String          @unique
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  monthlyIncome    Float
  salaryIncome     Float?
  otherIncome      Float?

  dataSource       String
  analysisMonth    DateTime
  createdAt        DateTime        @default(now())
}

model BankExpenseReport {
  id               String          @id @default(cuid())
  bankConnectionId String          @unique
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  monthlyExpenses  Float
  utilities        Float?
  housing          Float?
  food             Float?
  transport        Float?
  other            Float?

  dataSource       String
  analysisMonth    DateTime
  createdAt        DateTime        @default(now())
}

model BankRiskInsights {
  id               String          @id @default(cuid())
  bankConnectionId String          @unique
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  accountBalance   Float
  transactionVolume Float
  overdraftUsage   Boolean

  dataSource       String
  analysisDate     DateTime
  createdAt        DateTime        @default(now())
}

model BankReports {
  id                     String          @id @default(cuid())
  bankConnectionId       String          @unique
  bankConnection         BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)

  expensesJson           String
  incomeJson             String

  totalMonthlyExpenses   Float
  totalMonthlyIncome     Float

  createdAt              DateTime        @default(now())
  expiresAt              DateTime?

  @@index([bankConnectionId])
}

model Assessment {
  id                String          @id @default(cuid())
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  bankConnectionId  String?
  bankConnection    BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)

  monthlyIncome     Float?
  monthlyExpenses   Float?
  monthlyBill       Float?
  arrears           Float?

  disposableIncome  Float?
  billRatio         Float?
  hardshipLevel     String?
  sustainabilityScore String?

  incomeBreakdown   String?         // JSON: { salary, pension, benefits, cashDeposits, other, total }
  expenseBreakdown  String?         // JSON: { housing, food, utilities, transport, other, total }

  status            String          @default("PENDING")

  assessmentJob     AssessmentJob?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerId])
  @@index([bankConnectionId])
}

model AssessmentJob {
  id                String          @id @default(cuid())
  assessmentId      String          @unique
  assessment        Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  status            String          @default("PENDING")
  errorMessage      String?
  retryCount        Int             @default(0)

  createdAt         DateTime        @default(now())
  processedAt       DateTime?

  @@index([status])
}
