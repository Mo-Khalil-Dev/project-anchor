# Application
NODE_ENV=development
# RUNTIME: local | docker | ecs
RUNTIME=local
PORT=3000
LOG_LEVEL=debug

# Database
# DATABASE_PROVIDER: sqlite | postgresql
# Defaults: local → sqlite, docker/ecs → postgresql
# SQLite: DATABASE_URL is optional — defaults to file:./prisma/dev.db
# PostgreSQL: DATABASE_URL is required (used in production on Railway)
DATABASE_PROVIDER=sqlite
# DATABASE_URL will be set by Railway automatically
# For local development with PostgreSQL: postgresql://user:password@localhost:5432/safe_db

# Authentication (Cognito)
COGNITO_USER_POOL_ID=us-east-1_XXXXX
COGNITO_CLIENT_ID=XXXXX
COGNITO_REGION=us-east-1
JWT_SECRET=dev_secret_key_change_in_production

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=XXXXX

# Secrets Manager (only required when RUNTIME=ecs)
# SECRETS_MANAGER_SECRET_NAME=bridge/production/secrets

# Bank Integration (Tink)
TINK_CLIENT_ID=XXXXX
TINK_CLIENT_SECRET=XXXXX
TINK_ENVIRONMENT=sandbox

# Email Service (SES)
SES_REGION=us-east-1
SES_FROM_ADDRESS=noreply@bridge.local

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_XXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXX

# GoCardless (Direct Debit & Payment Processing)
GOCARDLESS_ACCESS_TOKEN=sandbox_20k7N9d4mIXdOMk08NEuxDzRZHUCviYxM__0obx_
GOCARDLESS_WEBHOOK_KEY=k9F#vT2xQ8mL$7pRzW4nC!sJ6yD@eH1uB5oA3GfX

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Background Job Processing
JOB_DISPATCH_DELAY_MS=35000

# Assessment Processing
ASSESSMENT_CREATION_DELAY_MS=0

# Feature Flags
ENABLE_EMAIL=true
ENABLE_PAYMENT_PROCESSING=true
ENABLE_BANK_OAUTH=true
