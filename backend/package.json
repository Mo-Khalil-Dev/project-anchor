{
  "name": "safe-backend",
  "version": "1.0.0",
  "description": "SAFE - Sustainable Affordability Financial Evaluation Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:mocks": "ts-node src/__mocks__/dev-server.ts",
    "build": "tsc",
    "start": "node --require tsconfig-paths/register dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:build": "docker build -t bridge:latest .",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "cdk:deploy": "cd infra && npm run deploy"
  },
  "keywords": [
    "hardship",
    "assessment",
    "utility",
    "payment-plans",
    "bridge"
  ],
  "author": "Mohamed Khalil",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1043.0",
    "@prisma/client": "^5.0.0",
    "aws-sdk": "^2.1400.0",
    "axios": "^1.15.2",
    "bullmq": "^5.76.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gocardless-nodejs": "^8.1.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-postgres": "^0.6.2",
    "pino": "^8.16.0",
    "pino-http": "^8.4.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.8.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "msw": "^1.3.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "prisma": "^5.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
